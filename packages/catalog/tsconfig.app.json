{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": [
    "src/**/*.ts",
    "../shared/src/lib/pipes/zod.pipe.ts",
    "../catalog-schema/src/schema/events.ts",
    "../catalog-schema/src/schema/eventPrices.ts",
    "../catalog-schema/src/schema/index.ts",
    "../catalog-schema/src/schema/schema.ts",
    "../catalog-schema/src/schema/venues.ts",
    "../catalog-schema/src/schema/relations.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../shared/tsconfig.lib.json"
    },
    {
      "path": "../catalog-schema/tsconfig.lib.json"
    }
  ]
}
