{
  "name": "@org/infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1141.0",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.5.0"
  },
  "nx": {
    "name": "infra",
    "tags": [
      "type:infra",
      "name:infra"
    ],
    "targets": {
      "synth": {
        "command": "cdk synth",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "catalog:prune",
          "admin:build"
        ]
      },
      "diff": {
        "cache": false,
        "command": "cdk diff",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "catalog:prune",
          "admin:build"
        ]
      },
      "deploy": {
        "cache": false,
        "command": "cdk deploy 'Dev/*' --concurrency 5",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "catalog:prune",
          "admin:build"
        ]
      },
      "destroy": {
        "cache": false,
        "command": "cdk destroy 'Dev/NetworkStack' --force --concurrency 5",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
