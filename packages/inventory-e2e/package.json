{
  "name": "@org/inventory-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "inventory-e2e",
    "implicitDependencies": [
      "inventory"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "inventory:build",
          "inventory:serve"
        ],
        "options": {
          "jestConfig": "packages/inventory-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
