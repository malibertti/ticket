      "request": "attach",
      "name": "Debug @org/catalog with Nx",
      "port": 9230,
      "restart": true,
      // "runtimeExecutable": "pnpm",
      // "runtimeArgs": ["exec", "nx", "serve", "@org/catalog"],
      // "env": {
      //   "NODE_OPTIONS": "--inspect=9230"
